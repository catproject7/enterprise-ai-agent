# Application environment: local, test, staging, or production.
ENTERPRISE_AI_AGENT_ENVIRONMENT=local

# Logging level: CRITICAL, ERROR, WARNING, INFO, or DEBUG.
ENTERPRISE_AI_AGENT_LOG_LEVEL=INFO

# OpenAI-compatible LLM configuration.
ENTERPRISE_AI_AGENT_LLM_MODEL=gpt-4o-mini
ENTERPRISE_AI_AGENT_LLM_API_KEY=
ENTERPRISE_AI_AGENT_LLM_BASE_URL=

# FastEmbed configuration.
ENTERPRISE_AI_AGENT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
ENTERPRISE_AI_AGENT_EMBEDDING_DIMENSION=384
ENTERPRISE_AI_AGENT_EMBEDDING_BATCH_SIZE=32
ENTERPRISE_AI_AGENT_EMBEDDING_CACHE_DIR=

# Qdrant configuration. Use :memory: for local development.
ENTERPRISE_AI_AGENT_QDRANT_URL=:memory:
ENTERPRISE_AI_AGENT_QDRANT_API_KEY=
ENTERPRISE_AI_AGENT_QDRANT_COLLECTION_NAME=document_chunks